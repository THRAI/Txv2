{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -Rs '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:.}}' AGENTS.md",
            "statusMessage": "Loading AGENTS.md into context"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(readelf *)",
      "Bash(fc-list *)",
      "mcp__codegraph__*"
    ]
  }
}
