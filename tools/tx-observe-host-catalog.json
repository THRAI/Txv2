  "event_families": [
    {
      "control_group": "always_on_when_observe_enabled",
      "id": "syscall",
      "levels": [
        "boundary"
      ],
      "payloads": [
        "syscall_enter",
        "syscall_exit",
        "arg_value"
      ],
      "projection": [
        "spans",
        "records",
        "ndjson",
        "perfetto",
        "text_report"
      ]
    },
    {
      "control_group": "always_on_when_observe_enabled",
      "id": "drive",
      "levels": [
        "drive",
        "step"
      ],
      "payloads": [
        "drive_begin",
        "drive_end",
        "step_outcome"
      ],
      "projection": [
        "spans",
        "records",
        "ndjson",
        "perfetto",
        "text_report"
      ]
    },
    {
      "control_group": "always_on_when_observe_enabled",
      "id": "yield",
      "levels": [
        "yield"
      ],
      "payloads": [
        "yield_begin",
        "resume",
        "wait_source_notify"
      ],
      "projection": [
        "spans",
        "records",
        "ndjson",
        "perfetto",
        "text_report"
      ]
    },
    {
      "control_group": "scheduler_reactor_metrics",
      "id": "scheduler",
      "levels": [
        "sched"
      ],
      "payloads": [
        "sched_switch",
        "process_label",
        "process_group",
        "process_fork"
      ],
      "projection": [
        "sched_intervals",
        "records",
        "ndjson",
        "perfetto",
        "text_report"
      ]
    },
    {
      "control_group": "always_on_when_callsite_enabled",
      "id": "allocation",
      "levels": [
        "mutation",
        "phase"
      ],
      "payloads": [
        "arg_value",
        "counter_value"
      ],
      "projection": [
        "allocation_rows",
        "records",
        "perfetto",
        "text_report"
      ]
    },
    {
      "control_group": "lock_metrics",
      "id": "lock",
      "levels": [
        "boundary"
      ],
      "payloads": [
        "counter_value"
      ],
      "projection": [
        "lock_rows",
        "records",
        "perfetto",
        "text_report"
      ]
    },
    {
      "control_group": "ds_metrics",
      "id": "ds_method",
      "levels": [
        "boundary"
      ],
      "payloads": [
        "counter_value"
      ],
      "projection": [
        "ds_method_rows",
        "records",
        "perfetto",
        "text_report"
      ]
    },
    {
      "control_group": "always_on_when_observe_enabled",
      "id": "phase",
      "levels": [
        "phase"
      ],
      "payloads": [
        "phase_transition"
      ],
      "projection": [
        "spans",
        "records",
        "ndjson",
        "perfetto"
      ]
    },
    {
      "control_group": "always_on_when_callsite_enabled",
      "id": "mutation",
      "levels": [
        "mutation"
      ],
      "payloads": [
        "mutation_zone_sign",
        "mutation_index_commit"
      ],
      "projection": [
        "records",
        "ndjson",
        "perfetto"
      ]
    },
    {
      "control_group": "always_on_when_observe_enabled",
      "id": "panic",
      "levels": [
        "boundary"
      ],
      "payloads": [
        "panic"
      ],
      "projection": [
        "records",
        "repairs",
        "ndjson",
        "perfetto",
        "text_report"
      ]
    }
  ],
