/target/
# vendor blobs are ignored by default (downloaded/large artifacts), BUT any
# file the kernel `include_bytes!`s is compile-required and must be
# whitelisted below — otherwise a fresh clone cannot build (netfast lesson).
# NOTE: must be `/vendor/*` (contents), not `/vendor/` (dir) — a fully
# ignored directory is never entered, so `!` re-includes would not work.
/tools/images/vendor/*
!/tools/images/vendor/tx-netfast-riscv64
!/tools/images/vendor/busybox-loongarch64-musl
!/tools/images/vendor/*.sha256
!/tools/images/vendor/*.SOURCE
/.cache/
**/.venv/
__pycache__/
.pytest_cache/
*.log
.DS_Store
/docs/ljs
.claude/settings.local.json
.claude/scheduled_tasks.lock
/document/ljs

# generated vendor snapshot
/third_party/
.claude/worktrees/
librust_out.rlib
/target-codex-check
local-images
